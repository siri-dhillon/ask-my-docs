# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Provider: anthropic | openai | ollama | fake
ASKDOCS_LLM_PROVIDER=anthropic
ASKDOCS_LLM_MODEL=claude-haiku-5-5
# ASKDOCS_LLM_PROVIDER=ollama
# ASKDOCS_LLM_MODEL=qwen3:4b
# ASKDOCS_OLLAMA_BASE_URL=http://localhost:11434/v1

# Retrieval
ASKDOCS_RETRIEVAL_MODE=hybrid_rerank   # vector | hybrid | hybrid_rerank
ASKDOCS_TOP_K=5
ASKDOCS_CHUNK_SIZE=220
ASKDOCS_CHUNK_OVERLAP=40
# ASKDOCS_RERANK_MODEL=BAAI/bge-reranker-base

# Use the docker-compose Qdrant instead of the embedded on-disk store
# ASKDOCS_QDRANT_URL=http://localhost:6333
